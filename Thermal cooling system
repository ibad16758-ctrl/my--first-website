#include <OneWire.h>
#include <DallasTemperature.h>

#define SENSOR_PIN 2

OneWire oneWire(SENSOR_PIN);
DallasTemperature sensor(&oneWire);

void setup() {
  Serial.begin(9600);
  sensor.begin();
}

void loop() {
  sensor.requestTemperatures();

  float temperature = sensor.getTempCByIndex(0);

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");

  delay(1000);
}
